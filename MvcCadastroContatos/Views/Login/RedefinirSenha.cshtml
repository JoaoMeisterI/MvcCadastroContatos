@model RedefinirSenhaModel
@{
    ViewData["Title"] = "Redefinir Senha";
    Layout="_LayoutDeslogado";
}

<div class="text-center">
    <h1 class="display-4">Redefinir Senha</h1>
</div>

<form asp-controller="Login" asp-action="EnviarLinkParaMudarSenha" method="post">
    <div class="form-group">
        <label for="login">Login</label>
        <input type="login" asp-for="Login" id="login" class="form-control" placeholder="Digite seu Login">
    </div>

    <div class="form-group">
        <label for="email">Senha</label>
        <input type="text" asp-for="Email" id="email" class="form-control" placeholder="Digite sua Senha">
    </div>

    <button type="submit" class="btn btn-primary mt-4 d-block w-100">Alterar Senha</button>
    <a class="btn btn-secondary mt-4" asp-controller="Login" asp-action="Index2" role="button">Voltar</a>
</form>
